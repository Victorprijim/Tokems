{
  "info": {
    "name": "API User Token",
    "_postman_id": "5b7e2c1a-9d3f-4c1e-8a2b-1f0e6d4c3b21",
    "description": "API Laravel con los modelos User y Token.\n\nIMPORTANTE (Laravel Herd): cambia la variable base_url por el nombre de tu carpeta del proyecto: http://<nombre-carpeta>.test/api (por defecto http://127.0.0.1:8000/api). Con php artisan serve sería http://127.0.0.1:8000/api.\n\nOrden recomendado: 1) Crear usuario, 2) Login (guarda el token automáticamente), 3) Cambiar nombre.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Listar usuarios (10 primeros)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/users",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "users"
          ]
        },
        "description": "Devuelve los 10 primeros usuarios (sin contraseña)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('La respuesta tiene success, message y data', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property('success');",
              "    pm.expect(json).to.have.property('message');",
              "    pm.expect(json).to.have.property('data');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Crear usuario",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/users",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "users"
          ]
        },
        "description": "Crea un usuario. El email debe ser único y la contraseña de al menos 8 caracteres. Devuelve 201.",
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"Víctor\",\n    \"email\": \"victor@example.com\",\n    \"password\": \"secreto123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('La respuesta tiene success, message y data', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property('success');",
              "    pm.expect(json).to.have.property('message');",
              "    pm.expect(json).to.have.property('data');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "login"
          ]
        },
        "description": "Devuelve el token en data y lo guarda en la variable {{token}}.",
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"victor@example.com\",\n    \"password\": \"secreto123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Guarda automáticamente el token devuelto en la variable de colección 'token'",
              "const json = pm.response.json();",
              "pm.test('Login correcto (200)', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(json.success).to.eql(true);",
              "});",
              "if (json.success && json.data) {",
              "    pm.collectionVariables.set('token', json.data);",
              "    console.log('Token guardado: ' + json.data);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Login (contraseña errónea)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "login"
          ]
        },
        "description": "Debe devolver 401 con success false.",
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"victor@example.com\",\n    \"password\": \"incorrecta\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Devuelve 401', function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Cambiar nombre (token en body)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/users/name",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "users",
            "name"
          ]
        },
        "description": "Cambia el nombre del usuario dueño del token.",
        "body": {
          "mode": "raw",
          "raw": "{\n    \"token\": \"{{token}}\",\n    \"name\": \"Víctor Actualizado\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('La respuesta tiene success, message y data', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property('success');",
              "    pm.expect(json).to.have.property('message');",
              "    pm.expect(json).to.have.property('data');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Cambiar nombre (Authorization Bearer)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/users/name",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "users",
            "name"
          ]
        },
        "description": "Alternativa: token en la cabecera Authorization: Bearer.",
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"Víctor Bearer\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('La respuesta tiene success, message y data', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property('success');",
              "    pm.expect(json).to.have.property('message');",
              "    pm.expect(json).to.have.property('data');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Cambiar nombre (token inválido)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/users/name",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "users",
            "name"
          ]
        },
        "description": "Debe devolver 401.",
        "body": {
          "mode": "raw",
          "raw": "{\n    \"token\": \"tokenfalso\",\n    \"name\": \"X\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Devuelve 401', function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api",
      "type": "string",
      "description": "Cámbiala por http://<nombre-de-tu-carpeta>.test/api (Herd) o http://127.0.0.1:8000/api (artisan serve)"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "Se rellena automáticamente al hacer Login"
    }
  ]
}